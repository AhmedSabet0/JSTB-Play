# Copy this file to .env and fill it in:  cp .env.example .env

# The server's domain. Its DNS A record must point to this server's public IP.
# No domain yet? Use <your-ip-with-dashes>.sslip.io, for example 3-120-45-67.sslip.io
DOMAIN=autoapply.example.com

# Password for https://DOMAIN/admin. Use a long one (16+ characters).
ADMIN_PASSWORD=

# Shown on the privacy policy and account deletion pages (Google Play requires a contact).
CONTACT_EMAIL=
# Who runs the service (your name or company), named on the privacy policy.
OPERATOR_NAME=
APP_NAME=Auto Apply

# "Applied today" counts days in this time zone.
TIMEZONE=Africa/Cairo

# Optional: the first OpenRouter key and model. You can also set (and change) them in the admin page.
OPENROUTER_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: the key that encrypts users' Google Drive sign-ins in the database (any long random string).
# Empty: a random key is made on first start and kept in data.key next to the database.
DATA_KEY=
